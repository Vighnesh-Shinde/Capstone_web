# Copy to backend/.env (gitignored) and fill in real values.
# Anything set as a real environment variable overrides this file.

# --- Operator admin account (seeded on first startup) -----------------------
# There is no self-service admin signup. This account is created once, then
# left alone on every subsequent boot.
ADMIN_USERNAME=your-admin-username
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-to-something-long
ADMIN_NAME=Your Name

# --- JWT signing ------------------------------------------------------------
# Generate a long random string for production. Never reuse the built-in dev default.
JWT_SECRET=change-me-to-a-long-random-string-at-least-64-characters-for-production

# --- Demo accounts ----------------------------------------------------------
# Leave false in production so no well-known demo login exists.
SEED_DEMO_DATA=false

# --- SMTP for password-reset emails ----------------------------------------
# Leave MAIL_HOST blank and reset links are written to the application log
# instead of emailed — useful for local development. For Gmail, MAIL_PASSWORD
# must be an App Password, not your account password.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com

# --- URLs -------------------------------------------------------------------
# Used to build password-reset links, so it must match where users reach the UI.
FRONTEND_BASE_URL=http://localhost:5173
ML_SERVICE_URL=http://localhost:8000
