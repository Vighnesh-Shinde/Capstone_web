# Copy this file to ".env" (same folder) and fill in real values.
# ".env" is gitignored — never commit real secrets.

USE_REAL_MODELS=true
HF_TOKEN=your-hugging-face-access-token-here

# Shared secret for the /internal/* operator endpoints the backend calls to
# validate and activate uploaded model weights. Must match ML_ADMIN_TOKEN in
# backend/.env. If this is unset, those endpoints refuse every request rather
# than allowing them unauthenticated.
#   Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ML_ADMIN_TOKEN=
