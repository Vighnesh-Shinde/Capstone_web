# uploaded media (local disk storage, not committed)
uploads/*
!uploads/.gitkeep

# backend
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
# local secrets: admin credentials, JWT signing key, SMTP password
backend/.env

# frontend
frontend/node_modules/
frontend/dist/
frontend/.env

# ml-service
ml-service/venv/
ml-service/__pycache__/
ml-service/app/__pycache__/
ml-service/.env
# ffmpeg binaries (~300MB) - downloaded per machine, see README.
# NOTE: the comment must be on its own line. Git only treats '#' as a comment
# at the start of a line, so a trailing "# ..." would become part of the
# pattern and silently match nothing.
ml-service/tools/
ml-service/**/__pycache__/

# your friend's shared model files/docs - not meant for the public repo
friend_shared_work/

# Your friend's full research repo (~1.4GB: trained models, extracted feature
# matrices, MentalBERT checkpoints). Reference material for implementing the
# feature extractors - not part of this application.
Friends_Work/

# DAIC-WOZ interview transcripts.
# NEVER COMMIT THIS. These are real clinical interviews with real people, held
# under a research licence that prohibits redistribution. Committing them -
# especially to a public remote - would breach that licence and expose the
# participants' data. Each machine obtains the corpus itself.
Dataset/

# OS / IDE
.DS_Store
.idea/
.vscode/
*.iml

# Local test media: a counsellor voice sample and a full session recording.
# Never committed — they are real recordings of a real person's voice and face,
# and an 80MB+ video would bloat the repository permanently. Referenced by the
# testing steps in the README; keep your own copies locally.
Test/

# Training artifacts: exported datasets contain real clinical features and
# real counsellor judgments, and trained models are large binaries produced
# from them. Both belong on the GPU box, not in version control.
training/*.zip
training/*.joblib
training/*.report.json
training/venv/

# Training outputs: model bundles and their reports are build artefacts, not
# source. They reach the app by being uploaded through Admin -> Models, which
# validates them, not by being committed.
training/*.joblib
training/*.report.json

# Models uploaded through Admin -> Models land beside the built-in ones, named
# <language>__<modality>__<label>.joblib, with active_manifest.json recording
# which are serving. Both are runtime state of one installation — and a
# .joblib is executable pickle — so neither belongs in the repository. The
# built-in models (no double underscore) stay tracked.
ml-service/models/*__*.joblib
ml-service/models/active_manifest.json

# The DAIC-WOZ training hand-offs, kept locally like Friends_Work/. Their
# weights and research logs (which name individual participants' labels) are
# derived from a licensed corpus; the models reach the app by being uploaded
# through Admin -> Models, never by being committed.
My_Work/
EarlyFusion_Work/
EarlyFusion_Work_V2/
__pycache__/
*.pyc
